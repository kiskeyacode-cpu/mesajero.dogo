rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Solo las cuentas que tú autorices pueden leer o escribir.
      // Cambia la lista por los correos reales de tu equipo.
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          "haiku@tu-dominio.com",
          "operador1@tu-dominio.com"
        ];
    }
  }
}
